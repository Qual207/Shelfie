{
  "name": "shelfie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "next build && concurrently --names web,store,shopper --prefix-colors blue,magenta,green \"next start\" \"pnpm:store-agent\" \"pnpm:shopper-agent\"",
    "demo:dev": "concurrently --names web,store,shopper --prefix-colors blue,magenta,green \"next dev\" \"pnpm:store-agent\" \"pnpm:shopper-agent\"",
    "store-agent": "tsx --env-file=.env agents/store-agent.ts",
    "shopper-agent": "tsx --env-file=.env agents/shopper-agent.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:history": "tsx scripts/seed-history.ts",
    "snapshot": "tsx scripts/snapshot.ts",
    "reset": "tsx scripts/reset.ts",
    "band-setup": "tsx --env-file=.env scripts/band-setup.ts",
    "ask-store": "tsx --env-file=.env scripts/ask-store.ts",
    "test:zoowork": "tsx --env-file=.env scripts/test-zoowork.ts",
    "crop": "tsx --env-file=.env scripts/crop.ts"
  },
  "dependencies": {
    "@band-ai/sdk": "0.5.0",
    "@zoowork-ai/sdk": "0.10.2",
    "better-sqlite3": "^13.0.3",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.2.2"
}
