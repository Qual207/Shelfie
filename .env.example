# ZooWork Project API key (platform.zoowork.ai)
ZOOWORK_API_KEY=

# Your Band account key (app.band.ai -> avatar -> Settings). `pnpm band-setup` uses it to register
# the two agents and create the demo rooms; the /shop page uses it to post the human's request into Band.
BAND_API_KEY=

# Filled by `pnpm band-setup`: the agents (app.band.ai -> Agents; API keys are shown once) and the
# "Shelfie demo" room the /shop page posts into.
STORE_AGENT_ID=
STORE_API_KEY=
SHOPPER_AGENT_ID=
SHOPPER_API_KEY=
BAND_ROOM_ID=
